<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.clojuredroid"
    android:versionCode="1"
    android:versionName="1.0" >

    <uses-sdk
        android:minSdkVersion="26"
        android:targetSdkVersion="35" />

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name="org.clojure_android.runtime.ClojureApp"
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:label="Clojure Android Sample"
        android:supportsRtl="true" >
        <activity
            android:name="com.example.clojuredroid.NekoActivity"
            android:exported="true"
            android:label="Neko UI Demo"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.example.clojuredroid.MainActivity"
            android:exported="true"
            android:label="Validation Tests" />
    </application>

</manifest>